# Copie para .env e ajuste.

# Intervalo base entre verificações (minutos). O monitor aumenta sozinho se houver erro/429.
INTERVAL_MINUTES=5
# Quantos produtos por chamada GraphQL em lote
BATCH_SIZE=10
# Caminho do banco SQLite
DB_PATH=data/monitor.db

# Contexto de região/moeda da Eneba
ENEBA_COUNTRY=BR
ENEBA_REGION=brazil
ENEBA_LANGUAGE=pt_BR
ENEBA_CURRENCY=BRL

# Alertas (opcionais). Sem eles, os alertas saem só no console.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
